#!/bin/sh
# dwl-wallpaper — span one image across all enabled outputs.
# Cache keyed by (mtime, layout); single-output skips magick entirely.
# Usage: dwl-wallpaper PATH

set -eu

IMG=${1:?usage: dwl-wallpaper IMG}
[ -f "$IMG" ] || { echo "no such file: $IMG" >&2; exit 1; }

command -v wlr-randr >/dev/null || { echo "wlr-randr required" >&2; exit 1; }
command -v swaybg    >/dev/null || { echo "swaybg required"    >&2; exit 1; }

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dwl-wallpaper"
mkdir -p "$CACHE"

# Per-output "name x y w h" from wlr-randr's plain-text dump.
LAYOUT=$(wlr-randr | awk '
    function flush() { if (n && en) print n, x, y, w, h }
    /^[^ \t]/        { flush(); n=$1; en=0; x=0; y=0; w=0; h=0 }
    /Enabled: yes/   { en=1 }
    /current\)/      { split($1, m, "x"); w=m[1]+0; h=m[2]+0 }
    /Position:/      { split($2, p, ","); x=p[1]+0; y=p[2]+0 }
    END              { flush() }
')
[ -n "$LAYOUT" ] || { echo "no enabled outputs" >&2; exit 1; }

if [ "$(echo "$LAYOUT" | wc -l)" -eq 1 ]; then
    pkill -x swaybg 2>/dev/null || true
    setsid -f swaybg -o "$(echo "$LAYOUT" | awk '{print $1}')" -i "$IMG" -m fill >/dev/null 2>&1
    exit 0
fi

W=$(echo "$LAYOUT" | awk '{ if ($2+$4>m) m=$2+$4 } END { print m }')
H=$(echo "$LAYOUT" | awk '{ if ($3+$5>m) m=$3+$5 } END { print m }')

spawn_all() {
    pkill -x swaybg 2>/dev/null || true
    echo "$LAYOUT" | while read -r name _x _y _w _h; do
        setsid -f swaybg -o "$name" -i "$CACHE/$name.png" -m fill >/dev/null 2>&1
    done
}

IMG_ABS=$(readlink -f "$IMG" 2>/dev/null || echo "$IMG")
IMG_MTIME=$(stat -c %Y "$IMG" 2>/dev/null || stat -f %m "$IMG" 2>/dev/null || echo 0)
SIG="$IMG_ABS|$IMG_MTIME|${W}x${H}|$LAYOUT"
SIG_FILE="$CACHE/sig"

cache_valid=0
[ -r "$SIG_FILE" ] && [ "$(cat "$SIG_FILE")" = "$SIG" ] && cache_valid=1
if [ "$cache_valid" = 1 ]; then
    while read -r name _x _y _w _h; do
        [ -f "$CACHE/$name.png" ] || { cache_valid=0; break; }
    done <<EOF
$LAYOUT
EOF
fi
[ "$cache_valid" = 1 ] && { spawn_all; exit 0; }

MAGICK=$(command -v magick || command -v convert) \
    || { echo "imagemagick required" >&2; exit 1; }

# Single magick invocation: load + resize once, clone/crop/write per output.
set -- "$IMG" -resize "${W}x${H}^" -gravity center -extent "${W}x${H}" +gravity
while read -r name x y w h; do
    set -- "$@" \( +clone -crop "${w}x${h}+${x}+${y}" +repage -write "$CACHE/$name.png" +delete \)
done <<EOF
$LAYOUT
EOF
"$MAGICK" "$@" null:

printf '%s' "$SIG" > "$SIG_FILE"
spawn_all
