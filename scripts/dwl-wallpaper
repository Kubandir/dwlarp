#!/bin/sh
# dwl-wallpaper — paint IMG on every enabled output independently.
# Each monitor gets its own swaybg fitting the full image (swaybg -m fill),
# so a multi-monitor layout shows the image once per monitor instead of one
# image sliced across the combined bounding box.
# Usage: dwl-wallpaper PATH

set -eu

IMG=${1:?usage: dwl-wallpaper IMG}
[ -f "$IMG" ] || { echo "no such file: $IMG" >&2; exit 1; }

command -v wlr-randr >/dev/null || { echo "wlr-randr required" >&2; exit 1; }
command -v swaybg    >/dev/null || { echo "swaybg required"    >&2; exit 1; }

# Enabled output names, one per line. wlr-randr can hang on some
# wlroots+Nvidia builds; the timeout leaves NAMES empty and we bail without
# clobbering existing swaybg state.
NAMES=$(timeout 3 wlr-randr 2>/dev/null | awk '
    /^[^ \t]/      { n=$1; en=0 }
    /Enabled: yes/ { en=1; print n }
')
[ -n "$NAMES" ] || { echo "no enabled outputs" >&2; exit 1; }

pkill -x swaybg 2>/dev/null || true
echo "$NAMES" | while read -r name; do
    setsid -f swaybg -o "$name" -i "$IMG" -m fill >/dev/null 2>&1
done
