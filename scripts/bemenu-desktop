#!/bin/sh
# Minimal .desktop app launcher for bemenu.
# Self-contained — no j4-dmenu-desktop dependency.
#
# Filters:  OnlyShowIn= (DE-specific tools)
#           NoDisplay=true (handlers, daemons)
#           HardwareSettings / DesktopSettings / X-XFCE categories
#
# Local ~/.local/share/applications overrides system /usr/share/applications,
# including NoDisplay=true hiding of system-visible entries.
#
# Terminal apps open in $TERMINAL (default: foot).
# Recent selections float to the top on next open.
# App list is cached and only rebuilt when .desktop files change.

TERMINAL="${TERMINAL:-foot}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/bemenu-desktop"
HISTORY="$CACHE/history"
APPDB="$CACHE/apps"

LOCAL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
SYS_DIR=/usr/share/applications

# awk program: resets state at each new file (FNR==1), prints on transition
# and in END. Handles multi-file single-invocation scanning.
_AWK='
FNR==1 {
    if (name!="" && !skip && ex!="") {
        gsub(/ ?%[a-zA-Z]/, "", ex)
        printf "%s\t%s\t%s\n", name, ex, term
    }
    in_entry=0; name=""; ex=""; term="false"; skip=0
}
/^\[Desktop Entry\]/ { in_entry=1; next }
/^\[/               { in_entry=0; next }
!in_entry           { next }
/^Type=/            { if ($0 !~ /=Application/) skip=1 }
/^NoDisplay=true/   { skip=1 }
/^OnlyShowIn=/      { skip=1 }
/^Categories=/ {
    if ($0 ~ /HardwareSettings|DesktopSettings|X-XFCE|Screensaver|PackageManager/) skip=1
}
/^Name=/ && name==""  { sub(/^Name=/, ""); name=$0 }
/^Exec=/ && ex==""   { sub(/^Exec=/, ""); ex=$0 }
/^Terminal=true/      { term="true" }
END {
    if (name!="" && !skip && ex!="") {
        gsub(/ ?%[a-zA-Z]/, "", ex)
        printf "%s\t%s\t%s\n", name, ex, term
    }
}
'

_needs_rebuild() {
    [ -f "$APPDB" ] || return 0
    find "$SYS_DIR" "$LOCAL_DIR" -name "*.desktop" -newer "$APPDB" -quit 2>/dev/null \
        | grep -q .
}

_rebuild() {
    # Local basenames that are hidden (NoDisplay/OnlyShowIn) — block system twins
    hidden=
    if [ -d "$LOCAL_DIR" ]; then
        for f in "$LOCAL_DIR"/*.desktop; do
            [ -f "$f" ] || continue
            grep -qE "^(NoDisplay=true|OnlyShowIn=)" "$f" 2>/dev/null && \
                hidden="$hidden $(basename "$f")"
        done
    fi

    # Collect file lists: local first, then system (excluding hidden-overridden ones)
    local_files=
    [ -d "$LOCAL_DIR" ] && for f in "$LOCAL_DIR"/*.desktop; do
        [ -f "$f" ] && local_files="$local_files $f"
    done

    sys_files=
    if [ -d "$SYS_DIR" ]; then
        for f in "$SYS_DIR"/*.desktop; do
            [ -f "$f" ] || continue
            base=$(basename "$f")
            case " $hidden " in *" $base "*) continue;; esac
            sys_files="$sys_files $f"
        done
    fi

    # Single awk pass over all files, deduplicated by name
    # shellcheck disable=SC2086
    awk "$_AWK" $local_files $sys_files \
        | sort | awk -F'\t' '!seen[$1]++' > "$APPDB.tmp" \
        && mv "$APPDB.tmp" "$APPDB"
}

mkdir -p "$CACHE"
_needs_rebuild && _rebuild

_menu() {
    if [ -f "$HISTORY" ]; then
        awk -F'\t' 'NR==FNR{h[$0]=1;next} ($1 in h){print $1}' \
            "$HISTORY" "$APPDB" | head -8
    fi
    awk -F'\t' '{print $1}' "$APPDB"
}

selection=$(
    _menu | awk '!seen[$0]++' | \
    bemenu -i -c -W 0.23 -l 12 \
        -p 'run:' \
        --fn 'FiraCode Nerd Font Propo SemiBold 11' \
        --fixed-height --scrollbar none \
        -B 2 --bdr '#3a7268' \
        --nb '#0d1418dd' --nf '#c8dde8' \
        --ab '#0d1418dd' --af '#c8dde8' \
        --tb '#0d1418dd' --tf '#5fa8a0' \
        --fb '#0d1418dd' --ff '#e6e8ee' \
        --hb '#1e3a38ee' --hf '#d8f8f4' \
        --sb '#0d1418dd' --sf '#c8dde8' \
        --cb '#3a7268'   --cf '#0d1418' \
        --scb '#0d1418dd' --scf '#c8dde8'
)

[ -z "$selection" ] && exit 0

entry=$(awk -F'\t' -v s="$selection" '$1==s{print;exit}' "$APPDB")
exec_cmd=$(printf '%s\n' "$entry" | cut -f2)
is_term=$(printf '%s\n' "$entry" | cut -f3)
[ -z "$exec_cmd" ] && exit 1

{
    printf '%s\n' "$selection"
    [ -f "$HISTORY" ] && grep -Fxv "$selection" "$HISTORY" || true
} | head -20 > "$HISTORY.tmp" && mv "$HISTORY.tmp" "$HISTORY"

if [ "$is_term" = "true" ]; then
    setsid "$TERMINAL" -e sh -c "$exec_cmd" &
else
    setsid sh -c "$exec_cmd" &
fi
