#!/bin/sh
# Minimal .desktop app launcher for bemenu.
# Replaces j4-dmenu-desktop with a self-contained POSIX script.
#
# Filters:  OnlyShowIn= entries (DE-specific tools)
#           NoDisplay=true entries (handlers, daemons)
#           HardwareSettings / DesktopSettings categories (settings panels)
#           X-XFCE / Screensaver / PackageManager categories
#
# Local ~/.local/share/applications overrides system /usr/share/applications
# (including NoDisplay=true overrides that hide system-visible entries).
#
# Terminal apps launch inside $TERMINAL (default: foot).
# Recent selections float to the top on next open.

TERMINAL="${TERMINAL:-foot}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/bemenu-desktop"
HISTORY="$CACHE/history"

_awk_parse='
BEGIN { in_entry=0; name=""; ex=""; term="false"; skip=0 }
/^\[Desktop Entry\]/ { in_entry=1; next }
/^\[/               { in_entry=0; next }
!in_entry           { next }
/^Type=/            { if ($0 !~ /=Application/) skip=1 }
/^NoDisplay=true/   { skip=1 }
/^OnlyShowIn=/      { skip=1 }
/^Categories=/ {
    if ($0 ~ /HardwareSettings|DesktopSettings|X-XFCE|Screensaver|PackageManager/) skip=1
}
/^Name=/ && name=="" { sub(/^Name=/, ""); name=$0 }
/^Exec=/ && ex==""  { sub(/^Exec=/, ""); ex=$0 }
/^Terminal=true/    { term="true" }
END {
    if (!skip && name!="" && ex!="") {
        gsub(/ ?%[a-zA-Z]/, "", ex)
        printf "%s\t%s\t%s\n", name, ex, term
    }
}
'

_scan() {
    local_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    sys_dir=/usr/share/applications

    # Collect basenames that the local dir hides (NoDisplay=true or OnlyShowIn=).
    # These block the matching system entry from appearing.
    hidden_local=
    if [ -d "$local_dir" ]; then
        for f in "$local_dir"/*.desktop; do
            [ -f "$f" ] || continue
            grep -qE "^(NoDisplay=true|OnlyShowIn=)" "$f" 2>/dev/null && \
                hidden_local="$hidden_local $(basename "$f")"
        done
    fi

    # Emit local apps (all non-hidden ones)
    if [ -d "$local_dir" ]; then
        for f in "$local_dir"/*.desktop; do
            [ -f "$f" ] || continue
            awk "$_awk_parse" "$f"
        done
    fi

    # Emit system apps, skipping any basename overridden locally
    if [ -d "$sys_dir" ]; then
        for f in "$sys_dir"/*.desktop; do
            [ -f "$f" ] || continue
            base=$(basename "$f")
            case " $hidden_local " in *" $base "*) continue;; esac
            awk "$_awk_parse" "$f"
        done
    fi
}

mkdir -p "$CACHE"
tmpdb=$(mktemp)
trap 'rm -f "$tmpdb"' EXIT INT TERM
_scan | sort | awk -F'\t' '!seen[$1]++' > "$tmpdb"

_menu() {
    if [ -f "$HISTORY" ]; then
        awk -F'\t' 'NR==FNR{h[$0]=1;next} ($1 in h){print $1}' \
            "$HISTORY" "$tmpdb" | head -8
    fi
    awk -F'\t' '{print $1}' "$tmpdb"
}

selection=$(
    _menu | awk '!seen[$0]++' | \
    bemenu -i -c -W 0.28 -l 12 \
        -p 'run:' \
        --fn 'FiraCode Nerd Font Propo SemiBold 11' \
        --fixed-height --scrollbar none \
        -B 1 -R 6 --bdr '#3a7268' \
        --nb '#000000cc' --nf '#c8dde8' \
        --ab '#000000cc' --af '#c8dde8' \
        --tb '#000000cc' --tf '#5fa8a0' \
        --fb '#000000cc' --ff '#e6e8ee' \
        --hb '#1a3630cc' --hf '#d8f8f4' \
        --sb '#000000cc' --sf '#c8dde8' \
        --cb '#3a7268'   --cf '#000000' \
        --scb '#000000cc' --scf '#c8dde8'
)

[ -z "$selection" ] && exit 0

entry=$(awk -F'\t' -v s="$selection" '$1==s{print;exit}' "$tmpdb")
exec_cmd=$(printf '%s\n' "$entry" | cut -f2)
is_term=$(printf '%s\n' "$entry" | cut -f3)
[ -z "$exec_cmd" ] && exit 1

{
    printf '%s\n' "$selection"
    [ -f "$HISTORY" ] && grep -Fxv "$selection" "$HISTORY" || true
} | head -20 > "$HISTORY.tmp" && mv "$HISTORY.tmp" "$HISTORY"

if [ "$is_term" = "true" ]; then
    setsid "$TERMINAL" -e sh -c "$exec_cmd" &
else
    setsid sh -c "$exec_cmd" &
fi
