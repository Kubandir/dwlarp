#!/bin/sh
# mullvad-vpn — toggle the Mullvad WireGuard tunnel, picking the fastest
# reachable CZ relay each time we bring it up.
#
#   mullvad-vpn up      pick fastest CZ relay, write config, wg-quick up
#   mullvad-vpn down    wg-quick down (idempotent)
#   mullvad-vpn status  prints "up" or "down"; exit 0 if up, 1 if down
#
# Lightweight: a single ping -c1 -W1 per relay (capped at TEST_N), pick the
# lowest-latency reply. If the chosen relay's handshake fails, we drop it and
# try the next-best — that's the auto-reconnect fallback.

set -eu

DIR=/etc/wireguard
IFACE=mullvad
CONF=$DIR/$IFACE.conf
KEY=$DIR/$IFACE.key
ADDR=$DIR/$IFACE.addr
RELAYS=$DIR/$IFACE.relays

TEST_N=5         # ping this many CZ relays
PING_TIMEOUT=1   # seconds

need_root() { [ "$(id -u)" = 0 ] || { echo "must run as root" >&2; exit 1; }; }

is_up() { ip link show "$IFACE" >/dev/null 2>&1; }

# Print "<latency_ms> <hostname> <pubkey> <ipv4>" for up to TEST_N relays.
# Unreachable relays are silently dropped. Output is sorted ascending by
# latency, so head -1 is the winner.
rank_relays() {
    [ -s "$RELAYS" ] || { echo "$RELAYS missing — run mullvad-wg-setup first" >&2; exit 1; }
    # shuffle so we don't always hammer the same N relays at the top of the
    # list; cheap diversification across cz-prg-wg-NNN.
    awk 'BEGIN{srand()} {print rand()"\t"$0}' "$RELAYS" \
        | sort -k1,1 | cut -f2- | head -n "$TEST_N" \
        | while read -r host pub ip; do
            t=$(ping -n -q -c1 -W"$PING_TIMEOUT" "$ip" 2>/dev/null \
                | awk -F'/' '/^rtt|^round-trip/ {print $5; exit}')
            [ -n "$t" ] && printf '%s %s %s %s\n' "$t" "$host" "$pub" "$ip"
        done | sort -n
}

write_conf() {
    # $1=pubkey $2=endpoint_ipv4
    priv=$(cat "$KEY")
    addr=$(cat "$ADDR")
    # We manage /etc/resolv.conf ourselves rather than using `DNS =` (which
    # invokes resolvconf and fails on systems without it set up). The mv-swap
    # works whether resolv.conf is a regular file or a symlink. PostDown's
    # `|| true` keeps teardown idempotent if the backup is already gone.
    # Confine umask 077 to a subshell — wg-quick later runs PostUp in this
    # same process, and a leaked tight umask would create /etc/resolv.conf as
    # 0600 root:root, locking non-root users out of name resolution.
    (umask 077; cat > "$CONF" <<EOF
# auto-generated by mullvad-vpn — do not edit by hand
[Interface]
PrivateKey = $priv
Address    = $addr
PostUp     = mv -f /etc/resolv.conf /etc/resolv.conf.mullvad-bak; printf 'nameserver 10.64.0.1\\n' > /etc/resolv.conf; chmod 644 /etc/resolv.conf
PostDown   = mv -f /etc/resolv.conf.mullvad-bak /etc/resolv.conf || true

[Peer]
PublicKey  = $1
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint   = $2:51820
EOF
)
}

bring_up() {
    is_up && { echo "already up"; return 0; }

    [ -r "$KEY" ] && [ -r "$ADDR" ] || {
        echo "missing $KEY or $ADDR — run mullvad-wg-setup first" >&2
        exit 1
    }

    ranked=$(rank_relays)
    [ -n "$ranked" ] || { echo "no CZ relay reachable" >&2; exit 1; }

    # Try relays in order of latency until one's handshake succeeds.
    echo "$ranked" | while read -r ms host pub ip; do
        echo "trying $host (${ms}ms)"
        write_conf "$pub" "$ip"
        if wg-quick up "$IFACE" >/dev/null 2>&1; then
            # WireGuard only initiates a handshake when there's outbound
            # traffic matching AllowedIPs. Ping Mullvad's in-tunnel DNS to
            # force one, then poll latest-handshakes for confirmation.
            for _ in 1 2 3 4 5; do
                ping -n -q -c1 -W1 10.64.0.1 >/dev/null 2>&1 || true
                hs=$(wg show "$IFACE" latest-handshakes 2>/dev/null \
                     | awk '{print $2}')
                [ -n "${hs:-}" ] && [ "$hs" -gt 0 ] 2>/dev/null && {
                    echo "connected via $host"
                    exit 0
                }
            done
            wg-quick down "$IFACE" >/dev/null 2>&1 || true
        fi
    done
    # If we got here, the subshell exit 0 didn't fire — check post-loop.
    is_up && exit 0
    echo "all candidates failed handshake" >&2
    exit 1
}

bring_down() {
    is_up || { echo "already down"; return 0; }
    wg-quick down "$IFACE"
}

case "${1:-}" in
    up)     need_root; bring_up ;;
    down)   need_root; bring_down ;;
    status) if is_up; then echo up; else echo down; exit 1; fi ;;
    *)      echo "usage: ${0##*/} up|down|status" >&2; exit 2 ;;
esac
