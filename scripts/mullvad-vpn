#!/bin/sh
# mullvad-vpn — bring the Mullvad WireGuard tunnel up/down.
#
#   mullvad-vpn up [HOSTNAME]    no host → fastest CZ relay (default)
#                                with host → that exact relay
#   mullvad-vpn down
#   mullvad-vpn status           exits 0 if up, 1 if down
#   mullvad-vpn current          prints the connected hostname (or empty)
#   mullvad-vpn list             prints the cached relay list (TSV)
#
# Bootstrap once with `sudo mullvad-wg-setup <ACCOUNT>`.

set -eu

DIR=/etc/wireguard
IFACE=mullvad
CONF=$DIR/$IFACE.conf
KEY=$DIR/$IFACE.key
ADDR=$DIR/$IFACE.addr
# /etc/wireguard is 0700 (it holds private keys), so anything user-side can't
# read files inside it. Park the public-facing relay catalogue and the
# "currently-connected hostname" marker in /run instead — tmpfs, world-
# readable, cleaned on reboot. The catalogue gets re-fetched lazily by
# ensure_relays() on the first `up` per boot.
RELAYS=/run/mullvad.relays
CURRENT=/run/mullvad.current
TEST_N=5
PING_TIMEOUT=1

need_root() { [ "$(id -u)" = 0 ] || { echo "must run as root" >&2; exit 1; }; }
is_up()     { ip link show "$IFACE" >/dev/null 2>&1; }

# A hard reboot while the tunnel was up leaves /etc/resolv.conf pointing at
# 10.64.0.1 (the in-tunnel resolver) because PostDown never ran. On the next
# boot the device is gone, so every DNS lookup hangs — including our own
# api.mullvad.net call inside ensure_relays. Restore the backup or fall back
# to a public resolver so we have working DNS long enough to handshake; once
# the tunnel is up, PostUp rewrites resolv.conf to 10.64.0.1 as usual.
sanitize_dns() {
	is_up && return 0
	grep -qE '^[[:space:]]*nameserver[[:space:]]+10\.64\.0\.1' \
		/etc/resolv.conf 2>/dev/null || return 0
	echo "stale tunnel resolver in /etc/resolv.conf — restoring" >&2
	if [ -s /etc/resolv.conf.mullvad-bak ]; then
		mv -f /etc/resolv.conf.mullvad-bak /etc/resolv.conf
	else
		printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /etc/resolv.conf
	fi
	chmod 644 /etc/resolv.conf
}

# Hostnames are constrained to mullvad's published shape (cc-city-wg-NNN). We
# enforce that here because this script is invoked via passwordless sudo, so
# the argument must never reach the shell as anything but a relay hostname.
valid_host() {
	case "$1" in
		*[!a-z0-9-]*|"") return 1 ;;
		*-*)             return 0 ;;
		*)               return 1 ;;
	esac
}

# Self-healing relay cache: if /etc/wireguard/mullvad.relays is missing or in
# the pre-2026 3-field format, fetch a fresh global list. Doesn't touch the
# device key or addr — only the public relay catalogue. Safe to call repeatedly.
ensure_relays() {
	if [ ! -s "$RELAYS" ] \
	   || ! awk -F'\t' 'NF<4 {exit 1}' "$RELAYS" 2>/dev/null; then
		echo "relay cache missing or stale — refreshing" >&2
		/usr/local/bin/mullvad-wg-setup relays >&2 \
			|| { echo "relay refresh failed" >&2; exit 1; }
	fi
}

# Print "<latency_ms> <hostname> <pubkey> <ipv4>" sorted ascending; head -1 wins.
# Filter is a country code; empty = no filter.
rank_relays() {
	cc=$1
	ensure_relays
	awk -F'\t' -v cc="$cc" '
		$1=="" {next}
		cc!="" && $4!=cc {next}
		{print $1"\t"$2"\t"$3}
	' "$RELAYS" \
	| awk 'BEGIN{srand()} {print rand()"\t"$0}' \
	| sort -k1,1 | cut -f2- | head -n "$TEST_N" \
	| while IFS='	' read -r host pub ip; do
		t=$(ping -n -q -c1 -W"$PING_TIMEOUT" "$ip" 2>/dev/null \
		    | awk -F/ '/^rtt|^round-trip/ {print $5; exit}')
		[ -n "$t" ] && printf '%s %s %s %s\n' "$t" "$host" "$pub" "$ip"
	done | sort -n
}

# Look up an exact hostname in the relay file. Prints "host\tpubkey\tipv4" or empty.
lookup_host() {
	ensure_relays
	awk -F'\t' -v h="$1" '$1==h {print $1"\t"$2"\t"$3; exit}' "$RELAYS"
}

write_conf() {
	# Confine umask 077 to a subshell — wg-quick runs PostUp in this same
	# process and a leaked tight umask would create /etc/resolv.conf 0600
	# root:root, locking non-root users out of name resolution.
	(umask 077; cat > "$CONF" <<EOF
# auto-generated by mullvad-vpn
[Interface]
PrivateKey = $(cat "$KEY")
Address    = $(cat "$ADDR")
PostUp     = mv -f /etc/resolv.conf /etc/resolv.conf.mullvad-bak; printf 'nameserver 10.64.0.1\\n' > /etc/resolv.conf; chmod 644 /etc/resolv.conf
PostDown   = mv -f /etc/resolv.conf.mullvad-bak /etc/resolv.conf || true

[Peer]
PublicKey  = $1
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint   = $2:51820
EOF
	)
}

# Try to bring up the tunnel using a single relay. On success, write the
# hostname to $CURRENT and return 0; on handshake failure, tear down and
# return non-zero so the caller can try the next candidate.
try_up() {
	host=$1; pub=$2; ip=$3
	write_conf "$pub" "$ip"
	wg-quick up "$IFACE" >/dev/null 2>&1 || return 1
	for _ in 1 2 3 4 5; do
		ping -n -q -c1 -W1 10.64.0.1 >/dev/null 2>&1 || true
		hs=$(wg show "$IFACE" latest-handshakes 2>/dev/null | awk '{print $2}')
		[ -n "${hs:-}" ] && [ "$hs" -gt 0 ] 2>/dev/null && {
			(umask 022; printf '%s\n' "$host" > "$CURRENT")
			echo "connected via $host"
			return 0
		}
	done
	wg-quick down "$IFACE" >/dev/null 2>&1 || true
	return 1
}

bring_up() {
	host_arg=${1:-}
	[ -r "$KEY" ] && [ -r "$ADDR" ] || {
		echo "missing $KEY or $ADDR — run mullvad-wg-setup first" >&2; exit 1
	}
	sanitize_dns

	# If a hostname was given, attempt that one only — bring an existing
	# tunnel down first so we don't silently keep the old endpoint.
	if [ -n "$host_arg" ]; then
		valid_host "$host_arg" || { echo "bad hostname: $host_arg" >&2; exit 2; }
		row=$(lookup_host "$host_arg")
		[ -n "$row" ] || { echo "unknown relay: $host_arg" >&2; exit 1; }
		is_up && wg-quick down "$IFACE" >/dev/null 2>&1 || true
		IFS='	' read -r host pub ip <<EOF
$row
EOF
		echo "connecting to $host"
		try_up "$host" "$pub" "$ip" && exit 0
		echo "handshake failed" >&2; exit 1
	fi

	is_up && { echo "already up"; return 0; }
	ranked=$(rank_relays cz)
	[ -n "$ranked" ] || { echo "no CZ relay reachable" >&2; exit 1; }

	echo "$ranked" | while read -r ms host pub ip; do
		echo "trying $host (${ms}ms)"
		try_up "$host" "$pub" "$ip" && exit 0
	done
	is_up && exit 0
	echo "all candidates failed handshake" >&2; exit 1
}

bring_down() {
	rm -f "$CURRENT"
	is_up || { echo "already down"; return 0; }
	wg-quick down "$IFACE"
}

case "${1:-}" in
	up)      need_root; bring_up "${2:-}" ;;
	down)    need_root; bring_down ;;
	status)  if is_up; then echo up; else echo down; exit 1; fi ;;
	current) [ -r "$CURRENT" ] && cat "$CURRENT" || true ;;
	list)    [ -s "$RELAYS" ] || { echo "$RELAYS missing — run mullvad-wg-setup first" >&2; exit 1; }
	         cat "$RELAYS" ;;
	*)       echo "usage: ${0##*/} up [HOST] | down | status | current | list" >&2; exit 2 ;;
esac
