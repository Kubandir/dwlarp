#!/bin/sh
# dwl-watch-outputs — re-run dwl-autolayout when the set of enabled outputs
# changes. Polls wlr-randr at 1Hz; cheap (microseconds) and protocol-stable.
#
# Triggers on output add/remove only — position changes do NOT retrigger
# (otherwise dwl-autolayout's own writes would loop).

set -eu

prev=""
while :; do
    cur=$(wlr-randr 2>/dev/null | awk '
        /^[^ \t]/      { n=$1 }
        /Enabled: yes/ { print n }
    ' | sort)
    if [ "$cur" != "$prev" ]; then
        prev=$cur
        "$HOME/.local/bin/dwl-autolayout" || true
        # Poke leftstatus to re-emit immediately so the new bar on a freshly
        # added output isn't blank until the next minute boundary.
        pkill -USR1 -x dwlb-leftstatus 2>/dev/null || true
    fi
    sleep 1
done
