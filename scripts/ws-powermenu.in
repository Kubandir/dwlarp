#!/bin/sh
# ws-powermenu — dmenu-wl power menu (Win+E).
# Entries: poweroff, reboot, hibernate, logout.

set -eu

# Nerd Font glyphs via printf so they survive any editor:
#    nf-fa-power_off  ·  nf-fa-refresh
#    nf-fa-pause      ·  nf-fa-sign_out
ICON_OFF=$(printf '\357\200\221')
ICON_REB=$(printf '\357\200\241')
ICON_HIB=$(printf '\357\212\215')
ICON_OUT=$(printf '\357\202\213')

mon_arg=
[ -n "${DWL_SELMON_OUTPUT:-}" ] && mon_arg="-m $DWL_SELMON_OUTPUT"
# shellcheck disable=SC2086
choice=$(printf '%s\n' \
	"$ICON_OFF Poweroff" \
	"$ICON_REB Reboot" \
	"$ICON_HIB Hibernate" \
	"$ICON_OUT Logout" \
	| dmenu-wl -i -p 'power:' $mon_arg \
		-fn 'FiraCode Nerd Font Bold 11' \
		-h 28 \
		-nb '@D_NB@' -nf '@D_NF@' \
		-sb '@D_SB@' -sf '@D_SF@')

[ -z "$choice" ] && exit 0

case "$choice" in
	*Poweroff)  exec loginctl poweroff ;;
	*Reboot)    exec loginctl reboot ;;
	*Hibernate) exec loginctl hibernate ;;
	*Logout)    exec pkill -x dwl ;;
esac
