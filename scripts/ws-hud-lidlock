#!/bin/sh
# ws-hud-lidlock — hold a logind/elogind handle-lid-switch inhibitor so closing
# the lid does not trigger hibernate. Driven by the HUD toggle.
#
#   ws-hud-lidlock on | off | status

set -eu

PIDF="${XDG_RUNTIME_DIR:-/tmp}/ws-hud-lidlock.pid"
INHIBIT=$(command -v elogind-inhibit || command -v systemd-inhibit) \
	|| { echo "need elogind-inhibit or systemd-inhibit" >&2; exit 1; }

alive() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; }
stop()  { [ -f "$PIDF" ] && { kill "$(cat "$PIDF")" 2>/dev/null || :; rm -f "$PIDF"; }; }

case "${1:-}" in
	on)
		alive && exit 0
		stop
		setsid sh -c 'exec "$0" \
			--what=handle-lid-switch --who=ws-hud \
			--why="user override (lid-lock toggle)" --mode=block \
			sleep infinity' "$INHIBIT" </dev/null >/dev/null 2>&1 &
		echo $! > "$PIDF" ;;
	off)    stop ;;
	status) alive && echo on || echo off ;;
	*)      echo "usage: ${0##*/} on|off|status" >&2; exit 2 ;;
esac
