#!/bin/sh
# Minimal .desktop app launcher piped into dmenu-wayland (dmenu-wl).
# Self-contained — no j4-dmenu-desktop dependency.
#
# Filters:  OnlyShowIn= (DE-specific tools)
#           NoDisplay=true (handlers, daemons)
#           HardwareSettings / DesktopSettings / X-XFCE categories
#
# Local ~/.local/share/applications overrides system /usr/share/applications,
# including NoDisplay=true hiding of system-visible entries.
#
# Cache strategy:
#   Parsed entries (Name<TAB>Exec<TAB>Terminal) live at
#       $XDG_CACHE_HOME/dmenu-launcher/apps
#   Each launch reads it instantly. If either applications directory's
#   mtime is newer than the cache (file added/removed), or any .desktop
#   file is newer than the cache (file edited), a background rebuild
#   runs so the NEXT launch sees the new state. Only the first run with
#   no cache pays the parse cost synchronously. Writes are atomic via
#   temp+rename.
#
# Terminal apps open in $TERMINAL (default: foot).
# Recent selections float to the top on next open.

set -eu

TERMINAL="${TERMINAL:-foot}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dmenu-launcher"
APPS="$CACHE/apps"
HISTORY="$CACHE/history"

LOCAL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
SYS_DIR=/usr/share/applications

mkdir -p "$CACHE"

_AWK='
FNR==1 {
    if (name!="" && !skip && ex!="") {
        gsub(/ ?%[a-zA-Z]/, "", ex)
        printf "%s\t%s\t%s\n", name, ex, term
    }
    in_entry=0; name=""; ex=""; term="false"; skip=0
}
/^\[Desktop Entry\]/ { in_entry=1; next }
/^\[/               { in_entry=0; next }
!in_entry           { next }
/^Type=/            { if ($0 !~ /=Application/) skip=1 }
/^NoDisplay=true/   { skip=1 }
/^OnlyShowIn=/      { skip=1 }
/^Categories=/ {
    if ($0 ~ /Screensaver|PackageManager/) skip=1
}
/^Name=/ && name==""  { sub(/^Name=/, ""); name=$0 }
/^Exec=/ && ex==""    { sub(/^Exec=/, ""); ex=$0 }
/^Terminal=true/      { term="true" }
END {
    if (name!="" && !skip && ex!="") {
        gsub(/ ?%[a-zA-Z]/, "", ex)
        printf "%s\t%s\t%s\n", name, ex, term
    }
}
'

# Build cache file, atomically. Local entries shadow system entries by name,
# and a NoDisplay=true override in $LOCAL_DIR also hides the system entry.
build() {
    out=$1
    tmp=$out.tmp.$$

    hidden=
    if [ -d "$LOCAL_DIR" ]; then
        for f in "$LOCAL_DIR"/*.desktop; do
            [ -f "$f" ] || continue
            grep -qE "^(NoDisplay=true|OnlyShowIn=)" "$f" 2>/dev/null \
                && hidden="$hidden $(basename "$f")"
        done
    fi

    local_files=
    if [ -d "$LOCAL_DIR" ]; then
        for f in "$LOCAL_DIR"/*.desktop; do
            [ -f "$f" ] && local_files="$local_files $f"
        done
    fi

    sys_files=
    if [ -d "$SYS_DIR" ]; then
        for f in "$SYS_DIR"/*.desktop; do
            [ -f "$f" ] || continue
            base=$(basename "$f")
            case " $hidden " in *" $base "*) continue;; esac
            sys_files="$sys_files $f"
        done
    fi

    # shellcheck disable=SC2086
    if awk "$_AWK" $local_files $sys_files \
        | sort | awk -F'\t' '!seen[$1]++' > "$tmp"; then
        mv "$tmp" "$out"
    else
        rm -f "$tmp"
        return 1
    fi
}

# Cache stale if missing, or any source dir/file is newer than the cache.
# Catches add/remove (dir mtime) and edit (file mtime).
stale() {
    [ -f "$APPS" ] || return 0
    for d in "$LOCAL_DIR" "$SYS_DIR"; do
        if [ -d "$d" ] && [ "$d" -nt "$APPS" ]; then return 0; fi
    done
    if find "$LOCAL_DIR" "$SYS_DIR" -maxdepth 1 -name '*.desktop' \
            -newer "$APPS" 2>/dev/null | grep -q .; then
        return 0
    fi
    return 1
}

# First run pays the parse cost; subsequent runs are instant.
[ -f "$APPS" ] || build "$APPS"

# Refresh in the background so the NEXT launch picks up any changes.
if stale; then
    (build "$APPS" </dev/null >/dev/null 2>&1) &
fi

APPDB=$(cat "$APPS")

_menu() {
    if [ -f "$HISTORY" ]; then
        printf '%s\n' "$APPDB" | awk -F'\t' \
            'NR==FNR{h[$0]=1;next} ($1 in h){print $1}' \
            "$HISTORY" - | head -8
    fi
    printf '%s\n' "$APPDB" | awk -F'\t' '{print $1}'
}

# Match the dwlb bar exactly: same font (FiraCode Nerd Font bold size 11),
# same bg (#000000cc — matches WS_BAR_BG), and the workspace-active gray
# (#2a2f3acc — matches WS_BAR_ACTIVE_BG) for the selected entry highlight.
selection=$(
    _menu | awk '!seen[$0]++' | \
    dmenu-wl -i -p 'run:' \
        -fn 'FiraCode Nerd Font Bold 11' \
        -h 28 \
        -nb '#000000' -nf '#ffffff' \
        -sb '#2a2f3a' -sf '#ffffff'
)

[ -z "$selection" ] && exit 0

entry=$(printf '%s\n' "$APPDB" | awk -F'\t' -v s="$selection" '$1==s{print;exit}')
exec_cmd=$(printf '%s\n' "$entry" | cut -f2)
is_term=$(printf '%s\n' "$entry" | cut -f3)
[ -z "$exec_cmd" ] && exit 1

{
    printf '%s\n' "$selection"
    [ -f "$HISTORY" ] && grep -Fxv "$selection" "$HISTORY" || true
} | head -20 > "$HISTORY.tmp" && mv "$HISTORY.tmp" "$HISTORY"

if [ "$is_term" = "true" ]; then
    setsid "$TERMINAL" -e sh -c "$exec_cmd" &
else
    setsid sh -c "$exec_cmd" &
fi
