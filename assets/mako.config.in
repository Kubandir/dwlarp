max-visible=3
sort=-time

font=FiraCode Nerd Font 11
width=340
height=130
margin=10
padding=14
border-size=2
border-radius=0
default-timeout=5000
ignore-timeout=0

background-color=@M_BG@
text-color=@M_FG@
border-color=@M_BORDER@
progress-color=over @M_PROG@

icons=1
max-icon-size=48
icon-location=left

layer=top
anchor=bottom-right

# DND mode: ws-hud toggle activates `do-not-disturb`, suppressing every
# notification (criticals included — narrow to low/normal if you want
# criticals to break through).
[mode=do-not-disturb]
invisible=1

[urgency=low]
border-color=@M_LOW@
default-timeout=3000

[urgency=normal]
border-color=@M_BORDER@
default-timeout=5000

[urgency=critical]
border-color=@M_CRIT@
default-timeout=0
ignore-timeout=1

# Volume / brightness OSD: quick, replaces in place. Keybinds send
# `-h string:x-canonical-private-synchronous:dwl-osd`, so each new event
# updates the same notification rather than stacking. The notification
# has only a title (no body) so the box collapses to one line and the
# text sits vertically centered; `text-alignment=center` handles
# horizontal centering. Mako paints the actual progress bar behind the
# text via the global `progress-color=over ...` rule.
[app-name=dwl-osd]
anchor=top-center
default-timeout=1200
ignore-timeout=1
width=320
height=64
padding=14
border-size=2
border-color=@M_BORDER@
text-alignment=center
group-by=app-name

# Mute variant — same app-name (so the synchronous-id replacement keeps
# it in the SAME notification on screen), only the colors change. The
# script publishes mute events with `-c muted`; this rule overrides the
# styling above. Geometry / anchor / alignment are inherited.
[category=muted]
background-color=@M_MUTE_BG@
border-color=@M_MUTE_BORDER@
text-color=@M_MUTE_FG@
