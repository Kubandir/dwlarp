max-visible=3
sort=-time

font=FiraCode Nerd Font 11
width=340
height=130
margin=10
padding=14
border-size=2
border-radius=0
default-timeout=5000
ignore-timeout=0

background-color=#0d1418f0
text-color=#c8e8f0
border-color=#3a7268
progress-color=over #1a3630

icons=1
max-icon-size=48
icon-location=left

layer=overlay
anchor=top-center

[urgency=low]
border-color=#1e3a3a
default-timeout=3000

[urgency=normal]
border-color=#3a7268
default-timeout=5000

[urgency=critical]
border-color=#ffffff
default-timeout=0
ignore-timeout=1
