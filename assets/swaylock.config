daemonize
show-failed-attempts
indicator-caps-lock

color=000000

font=FiraCode Nerd Font
font-size=14

indicator-radius=90
indicator-thickness=8

inside-color=00000000
inside-clear-color=00000000
inside-caps-lock-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000

# Ring tracks dwl: focus teal #3a7268 idle, lighter teal verifying, urgent red on wrong.
ring-color=3a7268a6
ring-clear-color=80b8a8a6
ring-caps-lock-color=e0b870a6
ring-ver-color=4a8a96a6
ring-wrong-color=d06878a6

key-hl-color=80b8a8
bs-hl-color=d06878
caps-lock-key-hl-color=e0b870
caps-lock-bs-hl-color=d06878

separator-color=00000000

text-color=a8d5cc
text-clear-color=80b8a8
text-caps-lock-color=e0b870
text-ver-color=98c8c0
text-wrong-color=d06878

layout-text-color=a8d5cc
layout-bg-color=1e3a3acc
layout-border-color=3a7268
